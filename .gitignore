# ignore build outputs
/build/**
/.claude/*
.clangd
/logs/*
*log*
core
WORKLOG.md

# but keep this script
!/build/clear_cmake.sh
!/build/build.sh
/benchmarks/

# track the TPDS extension docs (also negate the broad *log* rule above,
# which otherwise catches e.g. experiments_methodology.html → "methodology")
!/tpds_extension/**

fitcache_server_log.*
.ports.cfg.*
# Track benchmark summaries (.md, .yaml, etc.) under benchmarks/results/
# but skip the raw per-run artifacts: SLURM .out files, log4c logs, and the
# horovodrun stdout captures. Per-run sbatch shell scripts auto-generated
# by the driver (named with a timestamp + PID) are also skipped.
/benchmarks/results/**/*.log
/benchmarks/results/**/*.out
/benchmarks/results/**/2026*.sh

# FitCache LD_PRELOAD / server runtime logs — emitted in CWD; don't commit
fitcache_intercept_log.*
fitcache_server_log.*
